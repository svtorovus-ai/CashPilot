<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_main_bg"
    android:clickable="true" android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Navigation -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageButton
                    android:id="@+id/settings"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/widget_nav_button"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_sliders"
                    android:contentDescription="Налаштування" />

                <ImageButton
                    android:id="@+id/prevMonth"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/widget_nav_button"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_chevron_left"
                    android:contentDescription="Попередній місяць" />
            </LinearLayout>

            <TextView
                android:id="@+id/monthTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true">

                <ImageButton
                    android:id="@+id/nextMonth"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/widget_nav_button"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="Наступний місяць" />

                <ImageButton
                    android:id="@+id/reset"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/widget_nav_button"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_refresh"
                    android:contentDescription="Скинути локальні зміни" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Premium Section -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clickable="false">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Премія"
                android:textColor="#8B97A5"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/totalPremium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:text="0,00 грн"
                android:textColor="#B8D7FF"
                android:textSize="44sp"
                android:textStyle="bold" />
        </RelativeLayout>

